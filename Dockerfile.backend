# Etapa de builder
FROM maven:3.9-eclipse-temurin-21 AS builder

WORKDIR /app

# Copia solo los poms primero para aprovechar el cache de dependencias
COPY pom.xml .
COPY rag/pom.xml rag/pom.xml
# (Agrega COPY para otros módulos si tenés más)

# Baja dependencias (esto necesita la estructura de módulos)
RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:go-offline

# Ahora copiá el resto del código fuente
COPY . .

# Compila todo el multi-módulo, saltea tests para acelerar
RUN --mount=type=cache,target=/root/.m2 \
    mvn clean package -DskipTests

# Etapa final: sólo el jar ejecutable
FROM eclipse-temurin:21-jre
WORKDIR /app

# Copia el jar final generado por el submódulo 'rag'
COPY --from=builder /app/rag/target/*.jar /app/app.jar

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
