{
  "nivelRegex": {
    "pattern": "^\\s*LEVEL\\s+(\\d+):?",
    "key": "nivel"
  },
  "secciones": [
    {
      "regex": "^Nivel carrera",
      "metadata": { "area": "CARRERA" }
    },
    {
      "regex": "^Nivel tecnico",
      "metadata": { "area": "TECNICO" }
    },
    {
      "regex": "^Nivel liderazgo y gestion",
      "metadata": { "area": "LIDERAZGO" }
    },
    {
      "regex": "^Nivel tribu",
      "metadata": { "area": "TRIBU" }
    }
  ],
  "itemRegex": {
    "pattern": "^\\s*[•◦]\\s+(.+)",
    "key": "texto"
  },
  "enrichText": "Nivel {nivel} - Área {area}: {texto}"
}
